<?xml version="1.0" ?>
<sdf version="1.9">

  <model name="s4_truss_23_battery_top_right">

    <static>False</static>

    <!-- get the battery into TF -->
    <plugin
      filename="gz-sim-pose-publisher-system"
      name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>50</update_frequency>
    </plugin>

      <link name='base_link'>
        <inertial> <!--inertial properties of the link mass, inertia matix-->
          <mass>0.010</mass>
          <inertia>
            <ixx>0.095329</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.381317</iyy>
            <iyz>0</iyz>
            <izz>0.476646</izz>
          </inertia>
        </inertial>
        <visual name='visual'>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://iss_description/meshes/s4_truss_23_battery_top_right.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name='collision'>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://iss_description/meshes/s4_truss_23_battery_top_right.dae</uri>
            </mesh>
          </geometry>
        </collision>
      </link>
    </model>
</sdf>
