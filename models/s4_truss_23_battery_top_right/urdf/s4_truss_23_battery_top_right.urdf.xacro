<?xml version="1.0"?>
<robot name="link_23_s4_truss_battery_top_right" xmlns:xacro="http://www.ros.org/wiki/xacro">

   <!-- Battery Top Right -->
  <link name="link_23_s4_truss_battery_top_right">

    <inertial>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="100"  ixy="0"  ixz="0" iyy="100" iyz="0" izz="100" />
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://iss_description/meshes/s4_truss_23_battery_top_right.dae" scale="1 1 1"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://iss_description/meshes/s4_truss_23_battery_top_right.dae" scale="1 1 1"/>
      </geometry>
    </collision>

  </link>

